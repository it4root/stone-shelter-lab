# Local development credentials; change them for other environments.
POSTGRES_DB=stone_shelter
POSTGRES_USER=stone_shelter
POSTGRES_PASSWORD=stone_shelter_local

# Container connection settings; no Redis/Kafka business integration yet.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
# Future ChatMemory setting only; expiration is not implemented by this value.
CHAT_MEMORY_TTL=PT24H
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_EXTERNAL_PORT=29092
KAFKA_LOG_RETENTION_HOURS=24

# Ollama is installed/started by the user on the host, never in Compose.
SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
SPRING_AI_OLLAMA_CHAT_MODEL=qwen2.5:3b
SPRING_AI_OLLAMA_INIT_PULL_MODEL_STRATEGY=never
SPRING_AI_MODEL_EMBEDDING=none

# MinIO private gallery bucket; browser endpoint must be reachable from the UI.
MINIO_ROOT_USER=stone_shelter_local
MINIO_ROOT_PASSWORD=stone_shelter_minio_local
MINIO_BUCKET=stone-photos
MINIO_DRAFT_BUCKET=stone-photo-drafts
STONE_PHOTO_PLACEHOLDER_URL=http://localhost:8080/images/placeholder-rock.png
MINIO_BROWSER_ENDPOINT=http://localhost:9000
# For running the API outside Compose:
PHOTO_STORAGE_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=stone_shelter_local
MINIO_SECRET_KEY=stone_shelter_minio_local

# Daily backend cleanup; limits apply to the current single backend instance.
PHOTO_CLEANUP_CRON=0 0 3 * * *
PHOTO_CLEANUP_ZONE=UTC
PHOTO_CLEANUP_BATCH_SIZE=100
PHOTO_CLEANUP_MAX_OBJECTS=1000
PHOTO_CLEANUP_INTERVAL_MS=1000
PHOTO_CLEANUP_MAX_DURATION=PT30M
